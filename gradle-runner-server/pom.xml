<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jetbrains.teamcity.plugins</groupId>
    <artifactId>gradle-runner</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>gradle-runner-server</artifactId>
  <name>Gradle Runner</name>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.teamcity.plugins</groupId>
      <artifactId>gradle-runner-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.teamcity.plugins</groupId>
      <artifactId>gradle-runner-agent</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.teamcity.internal</groupId>
      <artifactId>server</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.teamcity</groupId>
      <artifactId>tests-support</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.teamcity</groupId>
        <artifactId>teamcity-maven-plugin</artifactId>
        <configuration>
          <agent>
            <spec>:gradle-runner-agent</spec>
            <pluginName>gradle-runner</pluginName>
            <extras>
              <extra>
                <source>${project.parent.basedir}/gradle-runner-agent/src/main/scripts</source>
                <destDir>scripts</destDir>
              </extra>
            </extras>
          </agent>
          <server>
            <spec>.</spec>
            <pluginName>Gradle</pluginName>
            <descriptor>
              <nodeResponsibilitiesAware>true</nodeResponsibilitiesAware>
              <useSeparateClassloader>true</useSeparateClassloader>
              <allowRuntimeReload>true</allowRuntimeReload>
            </descriptor>
            <extras>
              <extra>
                <source>${project.parent.basedir}/kotlin-dsl</source>
                <destDir>kotlin-dsl</destDir>
              </extra>
              <extra>
                <source>${project.parent.basedir}/ui-schemas</source>
                <destDir>ui-schemas</destDir>
              </extra>
            </extras>
          </server>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
